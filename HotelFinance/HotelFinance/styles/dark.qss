/* ==========================================================
   Charcoal + Gold Application Theme
========================================================== */

QWidget {
    background-color: #F4F4F5;
    color: #18181B;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow {
    background-color: #F4F4F5;
}

QLabel {
    background: transparent;
    color: #18181B;
}

QLabel#pageTitle {
    font-size: 18pt;
    font-weight: 600;
    color: #18181B;
}

QLabel#dateLabel,
QLabel#descriptionLabel,
QLabel#cardTitle,
QLabel#denominationQuantityLabel,
QLabel#denominationAmount {
    color: #71717A;
}

QLabel#sectionTitle {
    color: #27272A;
    font-size: 11pt;
    font-weight: 600;
}

QLabel#statusBadge {
    background-color: #DCFCE7;
    color: #166534;
    border: 1px solid #86EFAC;
    border-radius: 8px;
    padding: 4px 10px;
    font-weight: 600;
}

/* Sidebar and navigation */
QFrame#sidebar {
    background-color: #141416;
    border-right: 1px solid #27272A;
}

QLabel#sidebarBrand,
QLabel#sidebarMark {
    color: #F4F4F5;
}

QPushButton#navigationButton {
    background: transparent;
    color: #D4D4D8;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 6px;
    padding: 10px 12px;
    text-align: left;
    font-size: 14px;
}

QPushButton#navigationButton:hover {
    background-color: #27272A;
    color: #FFFFFF;
}

QPushButton#navigationButton:checked {
    background-color: #27272A;
    border-left-color: #D4AF37;
    color: #F4D97B;
}

/* Buttons */
QPushButton {
    background-color: #27272A;
    color: #FFFFFF;
    border: 1px solid #27272A;
    border-radius: 6px;
    min-height: 34px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #3F3F46;
    border-color: #BFA76A;
}

QPushButton:pressed {
    background-color: #18181B;
}

QPushButton#dangerButton {
    background-color: #DC2626;
    border-color: #DC2626;
}

QPushButton#dangerButton:hover {
    background-color: #B91C1C;
    border-color: #B91C1C;
}

QPushButton#denominationResetButton {
    background-color: #FFFFFF;
    color: #52525B;
    border: 1px solid #D4D4D8;
    min-height: 28px;
    padding: 4px 12px;
}

QPushButton#denominationResetButton:hover {
    background-color: #F4F4F5;
    border-color: #BFA76A;
}

/* Cards and sections */
QFrame#statCard,
QFrame#chartCard,
QFrame#reportFilterCard,
QFrame#denominationSection {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
}

QFrame#statCard:hover,
QFrame#chartCard:hover {
    border-color: #BFA76A;
}

QLabel#cardTitle {
    font-size: 12px;
    font-weight: 500;
}

QLabel#cardValue {
    color: #18181B;
    font-size: 28px;
    font-weight: 700;
}

QFrame#denominationCard {
    background-color: #F9FAFB;
    border: 1px solid #E4E4E7;
    border-radius: 6px;
}

QLabel#denominationLabel,
QLabel#denominationTotal,
QLabel#denominationTotalTitle {
    color: #18181B;
    font-weight: 600;
}

QLabel#denominationLabel {
    font-size: 15px;
}

QLabel#denominationTotal {
    color: #8A6D1D;
    font-size: 16px;
    font-weight: 700;
}

/* Inputs */
QLineEdit,
QComboBox,
QDateEdit,
QTimeEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    min-height: 34px;
    padding: 4px 8px;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #D4AF37;
}

QComboBox::drop-down,
QDateEdit::drop-down,
QTimeEdit::drop-down,
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    width: 20px;
}

QAbstractItemView {
    background-color: #FFFFFF;
    color: #18181B;
    selection-background-color: #F4E7B0;
    selection-color: #18181B;
    border: 1px solid #D4D4D8;
}

/* Tables */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAFAFA;
    color: #27272A;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    gridline-color: #E4E4E7;
    selection-background-color: #F4E7B0;
    selection-color: #18181B;
}

QTableWidget::item {
    padding: 6px;
    border-bottom: 1px solid #F1F1F2;
}

QTableWidget::item:hover {
    background-color: #FAF7ED;
}

QHeaderView::section,
QTableCornerButton::section {
    background-color: #27272A;
    color: #FFFFFF;
    border: none;
    padding: 9px;
    font-weight: 600;
}

/* Dialogs, scroll areas, and status */
QDialog {
    background-color: #F4F4F5;
}

QLabel#dialogTitle {
    color: #18181B;
    font-size: 22px;
    font-weight: 700;
}

QStatusBar {
    background-color: #FFFFFF;
    color: #71717A;
    border-top: 1px solid #E4E4E7;
}

QScrollArea {
    border: none;
    background-color: #F4F4F5;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #C4C4C8;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #BFA76A;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}
